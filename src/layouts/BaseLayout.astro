---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  showHeader?: boolean;
}

const { 
  title = "Harinandan K | Portfolio Website", 
  description = "Harinandan K - Portfolio Website. Student learning to build robust systems from the ground up, daily driving Linux, writing shell utilities, and managing database queries. Gearing up for SRE and Platform foundations.",
  showHeader = true
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <title>{title}</title>
  <link rel="icon" type="image/png" href="/website_logo.png">
</head>
<body>

  <!-- Header Section -->
  {showHeader && (
    <header>
      <div class="container header-container">
        <a href="#profile" class="brand">
          <div class="logo-box">HK</div>
          <div class="brand-text">Personnel File</div>
        </a>
        <nav>
          <a href="#profile" class="nav-link">Profile</a>
          <a href="#stack" class="nav-link">Stack</a>
          <a href="#projects" class="nav-link">Projects</a>
          <a href="#experience" class="nav-link">Experience</a>
          <a href="#contact" class="nav-btn">Get In Touch</a>
        </nav>
      </div>
    </header>
  )}

  <!-- Slot for Page Contents -->
  <slot />

  <!-- Footer Section -->
  <footer>
    <div class="container footer-container">
      <div>End of File</div>
      <div class="footer-center">Harinandan K · 2026</div>
      <div>Bangalore, KA</div>
    </div>
  </footer>

  <!-- Lenis Smooth Scrolling (Rubbery, Inertial Scroll) -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/lenis@1.1.13/dist/lenis.min.js"></script>
  <script is:inline>
    if (typeof Lenis !== 'undefined') {
      const lenis = new Lenis({
        duration: 1.3,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)), // Rubbery, elastic easing
        wheelMultiplier: 1.1,
        touchMultiplier: 1.8,
        smoothWheel: true,
        smoothTouch: false
      });

      function raf(time) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }

      requestAnimationFrame(raf);

      // Handle anchor link clicks smoothly with Lenis
      document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
          const targetId = this.getAttribute('href');
          if (targetId === '#') return;
          const target = document.querySelector(targetId);
          if (target) {
            e.preventDefault();
            lenis.scrollTo(target, { offset: -70 });
          }
        });
      });
    }
  </script>

  <script src="../scripts/main.js"></script>
</body>
</html>
