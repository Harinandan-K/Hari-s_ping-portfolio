---
import BaseLayout from '../layouts/BaseLayout.astro';
import certificates from '../data/certificates.json';
import '../styles/certificates.css';
---

<BaseLayout showHeader={false} title="Harinandan K | Certifications" description="Harinandan K - Professional certifications, credentials, and training program verifications.">
  <div class="container">
    <!-- Header -->
    <div class="projects-header">
      <h1>My Certifications</h1>
      <p>A collection of my verified professional certifications, academic credentials, and training programs.</p>
      <a href="/" class="back-home-btn">
        <svg width="14" height="14">
          <use href="/assets/icons.svg#icon-arrow-left"></use>
        </svg>
        Back to Home
      </a>
    </div>

    <!-- Certificates Cards Grid -->
    <main class="projects-grid" id="certificatesGrid">
      {certificates.map((cert) => {
        const isLocalPdf = cert.credential_url && cert.credential_url.startsWith('/Certificates/');
        const buttonText = isLocalPdf ? 'Open PDF' : 'Verify Certificate';
        const iconName = isLocalPdf ? 'icon-resume-filled' : 'icon-external-link';

        return (
          <article class="projects-card">
            {cert.banner_image ? (
              <div class="card-banner" style={`background-image: url('${cert.banner_image}'); background-size: cover; background-position: top center;`}>
                <div class={`card-badge ${cert.status_color === 'completed' ? 'green' : 'purple'}`}>
                  {cert.year}
                </div>
              </div>
            ) : (
              <div class="card-banner no-image">
                <div class="card-banner-graphic"></div>
                <div class="card-banner-text">{cert.issuer}</div>
                <div class={`card-badge ${cert.status_color === 'completed' ? 'green' : 'purple'}`}>
                  {cert.year}
                </div>
              </div>
            )}
            <div class="card-content">
              <h3 class="card-title">{cert.title}</h3>
              <p class="card-desc">{cert.description}</p>
              <div class="card-tags">
                {cert.tags.map((tag) => (
                  <span class={`card-tag ${tag.toLowerCase().replace(/[^a-z0-9]/g, '')}`}>{tag}</span>
                ))}
              </div>
              <div class="card-actions">
                {cert.links ? (
                  <div class="cert-links-container">
                    <a href={cert.links[0].url} class="card-btn card-btn-outline main-link" target="_blank" rel="noopener noreferrer">
                      {cert.links[0].label}
                      <svg width="11" height="11">
                        <use href="/assets/icons.svg#icon-resume-filled"></use>
                      </svg>
                    </a>
                    <div class="cert-modules-grid">
                      {cert.links.slice(1).map((link) => (
                        <a href={link.url} class="card-btn card-btn-outline sub-link" target="_blank" rel="noopener noreferrer">
                          {link.label}
                          <svg width="9" height="9">
                            <use href="/assets/icons.svg#icon-external-link"></use>
                          </svg>
                        </a>
                      ))}
                    </div>
                  </div>
                ) : cert.credential_url ? (
                  <a href={cert.credential_url} class="card-btn card-btn-outline" target="_blank" rel="noopener noreferrer">
                    {buttonText}
                    <svg width="11" height="11">
                      <use href={`/assets/icons.svg#${iconName}`}></use>
                    </svg>
                  </a>
                ) : (
                  <span class="card-btn card-btn-outline" style="opacity: 0.5; cursor: default; border-color: rgba(255, 255, 255, 0.03);">
                    No Link Available
                  </span>
                )}
              </div>
            </div>
          </article>
        );
      })}
    </main>
  </div>

  <!-- Scroll-to-Top Button -->
  <button id="scrollToTopBtn" class="scroll-to-top-btn" aria-label="Scroll to top">
    <svg width="18" height="18">
      <use href="/assets/icons.svg#icon-arrow-up"></use>
    </svg>
  </button>
</BaseLayout>
