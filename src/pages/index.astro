---
import BaseLayout from '../layouts/BaseLayout.astro';
import projects from '../data/projects.json';

const featuredProjects = projects.filter(p => p.id === 'idk' || p.id === 'ne1');
---

<BaseLayout>
  <!-- Profile/Hero Section -->
  <section id="profile" class="hero-section">
    <div class="container">
      <div class="personnel-card">
        <div class="card-header-bar">
          <div class="card-title-prefix">Personnel File</div>
          <div class="card-badge">BCA Hons Student</div>
        </div>
        
        <div class="card-body">
          <!-- Left: Profile Image Frame -->
          <div class="photo-frame-container">
            <div class="photo-wrapper">
              <img class="profile-img" src="/hari_pic.jpg" alt="Harinandan K">
              <div class="brackets-bot"></div>
            </div>
          </div>

          <!-- Right: Details -->
          <div class="profile-details">
            <div class="profile-role-tag">BCA Student</div>
            <h1 class="profile-name">Harinandan K</h1>
            <p class="profile-bio">
              Oh, me? I'm a student learning to build robust systems from the ground up. I daily drive Linux, write shell utilities, and manage database queries. Right now, I'm gearing up for the tech industry by developing SRE and Platform foundations.
            </p>

            <div class="vitals-table">
              <div class="vitals-row">
                <span class="vitals-label">Role</span>
                <span class="vitals-dots"></span>
                <span class="vitals-value">BCA Student</span>
              </div>
              <div class="vitals-row">
                <span class="vitals-label">Stack</span>
                <span class="vitals-dots"></span>
                <span class="vitals-value">Python · C · Bash · SQL · Linux</span>
              </div>
              <div class="vitals-row">
                <span class="vitals-label">Languages</span>
                <span class="vitals-dots"></span>
                <span class="vitals-value">English · Tamil · Kannada · Hindi</span>
              </div>
              <div class="vitals-row">
                <span class="vitals-label">Based</span>
                <span class="vitals-dots"></span>
                <span class="vitals-value">Bangalore, KA · UTC+5:30</span>
              </div>
              <div class="vitals-row">
                <span class="vitals-label">Status</span>
                <span class="vitals-dots"></span>
                <span class="vitals-value">
                  <span class="status-dot"></span>
                  <span class="status-text">Student</span>
                </span>
              </div>
            </div>

            <!-- Social Action Buttons -->
            <div class="button-panel">
              <a href="https://github.com/Harinandan-K" target="_blank" rel="noopener noreferrer" class="btn-outline">
                <svg width="14" height="14">
                  <use href="/assets/icons.svg#icon-github"></use>
                </svg>
                github
              </a>
              <a href="https://linkedin.com/in/harinandan-k" target="_blank" rel="noopener noreferrer" class="btn-outline">
                <svg width="14" height="14">
                  <use href="/assets/icons.svg#icon-linkedin"></use>
                </svg>
                linkedin
              </a>
              <a href="#" class="btn-outline copy-email">
                <svg width="14" height="14">
                  <use href="/assets/icons.svg#icon-email"></use>
                </svg>
                email
              </a>
              <a href="/HARINANDAN_K_Resume_bg.pdf" download="HARINANDAN_K_Resume_bg.pdf" class="btn-outline">
                <svg width="14" height="14">
                  <use href="/assets/icons.svg#icon-resume"></use>
                </svg>
                résumé
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2: Stack (Tools of Record) -->
  <section id="stack">
    <div class="container">
      <span class="section-tag">§02 / Skills</span>
      <h2 class="section-title">Tech Stack</h2>
      
      <div class="stack-grid">
        <!-- Linux -->
        <div class="stack-card linux">
          <div class="stack-icon-wrapper">
            <img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/linux/linux-original.svg" width="24" height="24" alt="Linux Tux logo">
          </div>
          <div class="stack-details">
            <span class="stack-title">Linux</span>
            <span class="stack-desc">Daily Driver System (Tux)</span>
          </div>
        </div>

        <!-- Docker -->
        <div class="stack-card docker">
          <div class="stack-icon-wrapper">
            <img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/docker/docker-original.svg" width="24" height="24" alt="Docker logo">
          </div>
          <div class="stack-details">
            <span class="stack-title">Docker</span>
            <span class="stack-desc">Containerization</span>
          </div>
        </div>

        <!-- Kubernetes -->
        <div class="stack-card kubernetes">
          <div class="stack-icon-wrapper">
            <img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/kubernetes/kubernetes-original.svg" width="24" height="24" alt="Kubernetes logo">
          </div>
          <div class="stack-details">
            <span class="stack-title">Kubernetes</span>
            <span class="stack-desc">Container Orchestration</span>
          </div>
        </div>

        <!-- Bash -->
        <div class="stack-card bash">
          <div class="stack-icon-wrapper">
            <img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/bash/bash-original.svg" width="24" height="24" alt="Bash logo">
          </div>
          <div class="stack-details">
            <span class="stack-title">Bash</span>
            <span class="stack-desc">Linux System Scripting</span>
          </div>
        </div>

        <!-- Python -->
        <div class="stack-card python">
          <div class="stack-icon-wrapper">
            <img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/python/python-original.svg" width="24" height="24" alt="Python logo">
          </div>
          <div class="stack-details">
            <span class="stack-title">Python</span>
            <span class="stack-desc">Languages & Automation</span>
          </div>
        </div>

        <!-- C -->
        <div class="stack-card c">
          <div class="stack-icon-wrapper">
            <img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/c/c-original.svg" width="24" height="24" alt="C logo">
          </div>
          <div class="stack-details">
            <span class="stack-title">C</span>
            <span class="stack-desc">System Level Programming</span>
          </div>
        </div>

        <!-- Git & GitHub -->
        <div class="stack-card git">
          <div class="stack-icon-wrapper">
            <img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/git/git-original.svg" width="24" height="24" alt="Git logo">
          </div>
          <div class="stack-details">
            <span class="stack-title">Git & GitHub</span>
            <span class="stack-desc">Version Control & Repos</span>
          </div>
        </div>

        <!-- SQL -->
        <div class="stack-card sql">
          <div class="stack-icon-wrapper">
            <svg width="24" height="24">
              <use href="/assets/icons.svg#icon-sql"></use>
            </svg>
          </div>
          <div class="stack-details">
            <span class="stack-title">SQL</span>
            <span class="stack-desc">Database & Data Analysis</span>
          </div>
        </div>

        <!-- SQLite -->
        <div class="stack-card sqlite">
          <div class="stack-icon-wrapper">
            <img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/sqlite/sqlite-original.svg" width="24" height="24" alt="SQLite logo">
          </div>
          <div class="stack-details">
            <span class="stack-title">SQLite</span>
            <span class="stack-desc">Lightweight Database</span>
          </div>
        </div>

        <!-- Tmux -->
        <div class="stack-card tmux">
          <div class="stack-icon-wrapper">
            <svg width="24" height="24" fill="none">
              <use href="/assets/icons.svg#icon-tmux"></use>
            </svg>
          </div>
          <div class="stack-details">
            <span class="stack-title">Tmux</span>
            <span class="stack-desc">Terminal Multiplexer</span>
          </div>
        </div>

        <!-- JavaScript -->
        <div class="stack-card javascript">
          <div class="stack-icon-wrapper">
            <img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/javascript/javascript-original.svg" width="24" height="24" alt="JavaScript logo">
          </div>
          <div class="stack-details">
            <span class="stack-title">JavaScript</span>
            <span class="stack-desc">Web Scripting</span>
          </div>
        </div>

        <!-- Prompt Eng -->
        <div class="stack-card prompt-eng">
          <div class="stack-icon-wrapper">
            <svg width="24" height="24" fill="none">
              <use href="/assets/icons.svg#icon-prompt-eng"></use>
            </svg>
          </div>
          <div class="stack-details">
            <span class="stack-title">Prompt Eng</span>
            <span class="stack-desc">AI Assisted Code Workflows</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 3: Projects (Selected Systems) -->
  <section id="projects">
    <div class="container">
      <span class="section-tag">§03 / Showcase</span>
      <h2 class="section-title">Projects</h2>
      
      <div class="project-grid">
        {featuredProjects.map((proj) => (
          <div class="project-card">
            <div>
              <div class="project-meta-line">
                <span class={proj.status_color}>{proj.status_text}</span>
              </div>
              <h3 class="project-title" style="font-size:22px; margin-bottom:12px;">{proj.title}</h3>
              <p class="project-desc" style="font-size:13.5px; margin-bottom:18px;">
                {proj.description}
              </p>
            </div>
            <div class="project-tags">
              <a href={proj.github_url} target="_blank" rel="noopener noreferrer" class="project-tag link-btn">
                <svg width="12" height="12">
                  <use href="/assets/icons.svg#icon-github"></use>
                </svg>
                Codebase ↗
              </a>
              {proj.tags.map((tag) => (
                <span class="project-tag">{tag}</span>
              ))}
            </div>
          </div>
        ))}

        <!-- Card 3: More Details Button -->
        <a href="/projects" class="project-card project-more-card">
          <div class="project-more-content">
            <div class="project-more-icon">
              <svg width="18" height="18">
                <use href="/assets/icons.svg#icon-folder-plus"></use>
              </svg>
            </div>
            <div>
              <div class="project-more-text">Click here for more project details</div>
              <div class="project-more-subtext" style="margin-top: 6px;">View all systems & open-source works</div>
            </div>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Section 4: Experience (Switchable Tabs: Work / Studies / Events) -->
  <section id="experience" class="scroll-reveal">
    <div class="container">
      <span class="section-tag">§04 / Track Record</span>
      <h2 class="section-title">Experience</h2>
      
      <!-- Tab Switcher -->
      <div class="experience-tabs-container">
        <div class="experience-tabs-bar">
          <button class="exp-tab-btn active" data-tab="work">Work</button>
          <button class="exp-tab-btn" data-tab="studies">Studies</button>
          <button class="exp-tab-btn" data-tab="events">Events</button>
        </div>
      </div>

      <!-- Experience Panel Card Container -->
      <div class="experience-panel-card">
        
        <!-- Tab Content: Work -->
        <div class="experience-tab-content active" id="exp-tab-work">
          <div class="experience-timeline">
            
            <!-- Work Item 1: Robotics Research Club -->
            <div class="exp-timeline-item">
              <div class="exp-timeline-icon">
                <svg width="15" height="15">
                  <use href="/assets/icons.svg#icon-shield"></use>
                </svg>
              </div>
              <div class="exp-timeline-content">
                <div class="exp-timeline-header">
                  <div class="exp-title-group">
                    <h3 class="exp-role-title">Robotics Research Club</h3>
                    <span class="exp-comp-title">Jain PNT Lab / Supported by IIT Tirupati</span>
                    <span class="timeline-badge green">Active</span>
                  </div>
                  <span class="exp-timeline-date">Active</span>
                </div>
                <p class="exp-timeline-desc">
                  Conducting robotics research, hardware-in-the-loop tests, and organizing technical workshops.
                </p>
              </div>
            </div>

            <!-- Work Item 2: Event Organizers Committee -->
            <div class="exp-timeline-item">
              <div class="exp-timeline-icon">
                <svg width="15" height="15">
                  <use href="/assets/icons.svg#icon-users"></use>
                </svg>
              </div>
              <div class="exp-timeline-content">
                <div class="exp-timeline-header">
                  <div class="exp-title-group">
                    <h3 class="exp-role-title">Event Organizers Committee</h3>
                    <span class="exp-comp-title">Jain University</span>
                    <span class="timeline-badge">Tech Lead</span>
                  </div>
                  <span class="exp-timeline-date">Jan 2026</span>
                </div>
                <p class="exp-timeline-desc">
                  Managed event software, network infrastructure, and sound engineering during inter-university symposiums.
                </p>
              </div>
            </div>
            
          </div>

          <!-- Publications Sub-section inside Work Tab -->
          <h3 class="publications-title" style="margin-top: 50px;">Publications & Patents</h3>
          <div class="publications-grid">
            <!-- Publication 1 -->
            <div class="pub-card">
              <div>
                <div class="pub-meta">
                  <span class="pub-meta-left">Patent, India</span>
                  <span>1 Year</span>
                </div>
                <h4 class="pub-title">Smart Traffic Signal Pole System (TraffiParkAI)</h4>
                <p class="pub-desc">
                  Invented and submitted a patent for a dynamic traffic control pole system leveraging localized sensor feeds.
                </p>
              </div>
              <div class="timeline-tags">
                <span class="timeline-tag">Patent</span>
                <span class="timeline-tag">TraffiParkAI</span>
                <span class="timeline-tag">Sensor Systems</span>
                <span class="timeline-tag">AI Control</span>
              </div>
            </div>

            <!-- Publication 2 -->
            <div class="pub-card">
              <div>
                <div class="pub-meta">
                  <span class="pub-meta-left">Research Paper</span>
                  <span>3 Months</span>
                </div>
                <h4 class="pub-title">Gen Z Digital Payment Platforms Study</h4>
                <p class="pub-desc">
                  Published an academic paper analyzing the adoption rates and security perceptions of mobile payments among youth in Bangalore.
                </p>
              </div>
              <div class="timeline-tags">
                <span class="timeline-tag">Research</span>
                <span class="timeline-tag">Digital Payments</span>
                <span class="timeline-tag">Data Analysis</span>
                <span class="timeline-tag">Gen Z Study</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Tab Content: Studies -->
        <div class="experience-tab-content" id="exp-tab-studies">
          <div class="experience-timeline">
            
            <!-- Studies Item 1: Jain University -->
            <div class="exp-timeline-item">
              <div class="exp-timeline-icon">
                <svg width="15" height="15">
                  <use href="/assets/icons.svg#icon-school"></use>
                </svg>
              </div>
              <div class="exp-timeline-content">
                <div class="exp-timeline-header">
                  <div class="exp-title-group">
                    <h3 class="exp-role-title">Bachelor of Computer Applications</h3>
                    <span class="exp-comp-title">Jain Deemed-To-Be University (3rd Year)</span>
                  </div>
                  <span class="exp-timeline-date">2024 — Present</span>
                </div>
                <p class="exp-timeline-desc">
                  Specializing in Robotics. Maintaining an Academic Average of 9.022 CGPA.
                </p>
              </div>
            </div>

            <!-- Studies Item 2: Vidyaniketan -->
            <div class="exp-timeline-item">
              <div class="exp-timeline-icon">
                <svg width="15" height="15">
                  <use href="/assets/icons.svg#icon-reading"></use>
                </svg>
              </div>
              <div class="exp-timeline-content">
                <div class="exp-timeline-header">
                  <div class="exp-title-group">
                    <h3 class="exp-role-title">Higher Secondary Education (PCMCs)</h3>
                    <span class="exp-comp-title">Vidyaniketan Public School</span>
                  </div>
                  <span class="exp-timeline-date">Graduated 2024</span>
                </div>
                <p class="exp-timeline-desc">
                  Focused study on Physics, Chemistry, Math, and Computer Science (PCMCs).
                </p>
              </div>
            </div>
            
          </div>

          <!-- Certifications Sub-section inside Studies Tab -->
          <h3 class="publications-title" style="margin-top: 50px;">Certifications</h3>
          <div class="publications-grid">
            <!-- Cert 1 -->
            <div class="pub-card">
              <div>
                <div class="pub-meta">
                  <span class="pub-meta-left">Certificate</span>
                  <span>2025</span>
                </div>
                <h4 class="pub-title">Generative AI: Prompt Engineering</h4>
                <p class="pub-desc">
                  Advanced certification focusing on LLM architecture, prompt structure optimization, and agentic workflows.
                </p>
              </div>
            </div>

            <!-- Cert 2 -->
            <div class="pub-card">
              <div>
                <div class="pub-meta">
                  <span class="pub-meta-left">Certificate</span>
                  <span>2024</span>
                </div>
                <h4 class="pub-title">Git & GitHub Developer Certificate</h4>
                <p class="pub-desc">
                  Focused on version control systems, team branching flows, CI/CD configuration, and open-source collaboration patterns.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Tab Content: Events -->
        <div class="experience-tab-content" id="exp-tab-events">
          <div class="experience-timeline">
            
            <!-- Event Item 1: Drone Tech Workshop -->
            <div class="exp-timeline-item">
              <div class="exp-timeline-icon">
                <svg width="15" height="15">
                  <use href="/assets/icons.svg#icon-briefcase"></use>
                </svg>
              </div>
              <div class="exp-timeline-content">
                <div class="exp-timeline-header">
                  <div class="exp-title-group">
                    <h3 class="exp-role-title">Drone Tech Workshop Member</h3>
                    <span class="exp-comp-title">Jain PNT Lab</span>
                    <span class="timeline-badge">Recent</span>
                  </div>
                  <span class="exp-timeline-date">Apr 2026</span>
                </div>
                <p class="exp-timeline-desc">
                  Completed intensive drone configuration, flight mechanics, and telemetry calibration workshops.
                </p>
                <div class="timeline-tags">
                  <span class="timeline-tag">Flight Telemetry</span>
                  <span class="timeline-tag">Drone Electronics</span>
                  <span class="timeline-tag">ESC Calibration</span>
                </div>
              </div>
            </div>

            <!-- Event Item 2: e-Yantra -->
            <div class="exp-timeline-item">
              <div class="exp-timeline-icon">
                <svg width="15" height="15">
                  <use href="/assets/icons.svg#icon-code-arrow"></use>
                </svg>
              </div>
              <div class="exp-timeline-content">
                <div class="exp-timeline-header">
                  <div class="exp-title-group">
                    <h3 class="exp-role-title">e-Yantra Robotics Participant</h3>
                    <span class="exp-comp-title">IIT Bombay</span>
                  </div>
                  <span class="exp-timeline-date">Nov 2025</span>
                </div>
                <p class="exp-timeline-desc">
                  Qualified for Stage 1 in the premier national robotics competition. Programmed control loops, sensor data interpretation routines, and hardware coordination logic.
                </p>
                <div class="timeline-tags">
                  <span class="timeline-tag">Python</span>
                  <span class="timeline-tag">C</span>
                  <span class="timeline-tag">Sensor Integration</span>
                  <span class="timeline-tag">Control Loops</span>
                </div>
              </div>
            </div>

            <!-- Event Item 3: Hackathon -->
            <div class="exp-timeline-item">
              <div class="exp-timeline-icon">
                <svg width="15" height="15">
                  <use href="/assets/icons.svg#icon-star"></use>
                </svg>
              </div>
              <div class="exp-timeline-content">
                <div class="exp-timeline-header">
                  <div class="exp-title-group">
                    <h3 class="exp-role-title">Hackathon Competitor (Runner Up)</h3>
                    <span class="exp-comp-title">Design India Hackathon · Deens Academy</span>
                  </div>
                  <span class="exp-timeline-date">Aug 2024</span>
                </div>
                <p class="exp-timeline-desc">
                  Prototyped and deployed hardware/software solutions addressing civic challenges. Won Runner-Up position in a competitive hackathon.
                </p>
                <div class="timeline-tags">
                  <span class="timeline-tag">Hardware Prototyping</span>
                  <span class="timeline-tag">UI Prototyping</span>
                  <span class="timeline-tag">Presentation</span>
                </div>
              </div>
            </div>
            
          </div>
        </div>
        
      </div>
    </div>
  </section>

  <!-- Section 6: Contact (Open a thread) -->
  <section id="contact">
    <div class="container">
      <span class="section-tag">§06 / Contact</span>
      <h2 class="section-title">Open a thread</h2>
      
      <div class="contact-card">
        <!-- Left: Description and Email Copy CTA -->
        <div class="contact-left">
          <p class="contact-desc">
            Got a question, a project idea, or just want to chat about systems engineering, platform development, or DevOps foundations? Drop a line and let's talk.
          </p>
          <a href="#" class="contact-cta-btn copy-email">
            harinandankedambi@gmail.com ↗
          </a>
          <span class="contact-subtext">BANGALORE, IN</span>
        </div>

        <!-- Right: Connection Methods list -->
        <div class="contact-right">
          <div class="contact-box">
            <!-- Email Row -->
            <div class="contact-row">
              <span class="contact-icon">
                <svg width="14" height="14">
                  <use href="/assets/icons.svg#icon-email"></use>
                </svg>
              </span>
              <span class="contact-label">EMAIL</span>
              <a href="#" class="contact-value-link copy-email">harinandankedambi@gmail.com</a>
            </div>
            <!-- LinkedIn Row -->
            <div class="contact-row">
              <span class="contact-icon">
                <svg width="14" height="14">
                  <use href="/assets/icons.svg#icon-linkedin"></use>
                </svg>
              </span>
              <span class="contact-label">LINKEDIN</span>
              <a href="https://linkedin.com/in/harinandan-k" target="_blank" rel="noopener noreferrer" class="contact-value-link">in/harinandan-k</a>
            </div>
            <!-- GitHub Row -->
            <div class="contact-row">
              <span class="contact-icon">
                <svg width="14" height="14">
                  <use href="/assets/icons.svg#icon-github"></use>
                </svg>
              </span>
              <span class="contact-label">GITHUB</span>
              <a href="https://github.com/Harinandan-K" target="_blank" rel="noopener noreferrer" class="contact-value-link">Harinandan-K</a>
            </div>
            <!-- Résumé Row -->
            <div class="contact-row">
              <span class="contact-icon">
                <svg width="14" height="14">
                  <use href="/assets/icons.svg#icon-resume"></use>
                </svg>
              </span>
              <span class="contact-label">RÉSUMÉ</span>
              <a href="/HARINANDAN_K_Resume_bg.pdf" download="HARINANDAN_K_Resume_bg.pdf" class="contact-value-link">Download CV (PDF)</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
